<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta principal con el degradado de la marca. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="@color/gamora_hero_start"
                android:centerColor="@color/gamora_hero_center"
                android:endColor="@color/gamora_hero_end" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Brillo suave en la esquina superior derecha -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="1"
                android:centerY="0"
                android:gradientRadius="70%"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
