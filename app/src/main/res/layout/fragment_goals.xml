<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gamora_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/categoria_ahorro"
            android:textAppearance="@style/TextAppearance.Gamora.Overline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/goals_mis_metas"
            android:textAppearance="@style/TextAppearance.Gamora.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/goals_convierte_tus_planes_en"
            android:textAppearance="@style/TextAppearance.Gamora.Body" />

        <LinearLayout
            style="@style/Gamora.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/goals_ahorrado_en_tus_metas"
                android:textColor="@color/gamora_on_hero_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtTotalSaved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/analytics_0_00"
                android:textAppearance="@style/TextAppearance.Gamora.Amount" />

            <TextView
                android:id="@+id/txtGoalsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dashboard_expense"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/goals_0_metas_activas"
                android:textColor="@color/gamora_on_hero"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/goals_crear_nueva_meta" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/goals_tus_objetivos"
            android:textAppearance="@style/TextAppearance.Gamora.Title" />

        <LinearLayout
            android:id="@+id/layoutGoals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtEmptyGoals"
                style="@style/Gamora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="28dp"
                android:text="@string/goals_n_ntodavia_no_tienes"
                android:textAppearance="@style/TextAppearance.Gamora.Body" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
