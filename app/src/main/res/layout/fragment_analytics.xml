<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gamora_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tus números"
            android:textAppearance="@style/TextAppearance.Gamora.Overline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Análisis"
            android:textAppearance="@style/TextAppearance.Gamora.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Comprende tus finanzas y toma mejores decisiones."
            android:textAppearance="@style/TextAppearance.Gamora.Body" />

        <!-- Balance general -->
        <LinearLayout
            style="@style/Gamora.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balance general"
                android:textColor="@color/gamora_on_hero_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtAnalyticsBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="$0.00"
                android:textAppearance="@style/TextAppearance.Gamora.Amount" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_expense"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↑  Ingresos"
                        android:textColor="@color/gamora_on_hero_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtAnalyticsIncome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:text="$0.00"
                        android:textAppearance="@style/TextAppearance.Gamora.AmountSmall"
                        android:textColor="@color/gamora_on_hero"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_expense"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↓  Gastos"
                        android:textColor="@color/gamora_on_hero_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtAnalyticsExpenses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:text="$0.00"
                        android:textAppearance="@style/TextAppearance.Gamora.AmountSmall"
                        android:textColor="@color/gamora_on_hero"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Gastos por categoría -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="¿A dónde va tu dinero?"
            android:textAppearance="@style/TextAppearance.Gamora.Title" />

        <LinearLayout
            style="@style/Gamora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="20dp">

            <com.gamora.feature.analytics.DonaView
                android:id="@+id/graficaGastos"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutExpenseCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtEmptyAnalytics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="📊\n\nTodavía no hay gastos para analizar.\nCuando registres movimientos, aquí verás a dónde va tu dinero."
                    android:textAppearance="@style/TextAppearance.Gamora.Body" />
            </LinearLayout>
        </LinearLayout>

        <!-- Presupuesto por categoría -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Presupuesto por categoría"
                android:textAppearance="@style/TextAppearance.Gamora.Title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarPresupuestos"
                style="@style/Widget.Gamora.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="Editar" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPeriodoPresupuesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Gamora.Caption" />

        <LinearLayout
            android:id="@+id/layoutPresupuestos"
            style="@style/Gamora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="20dp" />

        <!-- Ingresos vs. gastos -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Ingresos vs. gastos"
            android:textAppearance="@style/TextAppearance.Gamora.Title" />

        <LinearLayout
            style="@style/Gamora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Últimos 6 meses"
                    android:textAppearance="@style/TextAppearance.Gamora.Caption" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Ingresos"
                    android:textColor="@color/gamora_income"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="● Gastos"
                    android:textColor="@color/gamora_expense"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.gamora.feature.analytics.BarrasMensualesView
                android:id="@+id/graficaMeses"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- Consejos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/gamora_accent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consejos para ti"
                android:textAppearance="@style/TextAppearance.Gamora.Title" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtConsejos"
            style="@style/Gamora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="5dp"
            android:padding="20dp"
            android:text="Registra tus movimientos para que Gamora pueda identificar patrones de gasto y darte recomendaciones."
            android:textColor="@color/gamora_text_primary"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
