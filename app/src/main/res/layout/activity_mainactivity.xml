<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="@color/gamora_hero_chip"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/login_screen_g"
            android:textColor="@color/gamora_on_hero"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/mainactivity_bienvenido_a"
            android:textColor="@color/gamora_on_hero_secondary"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:text="@string/app_name"
            android:textColor="@color/gamora_on_hero"
            android:textSize="48sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/mainactivity_controla_tu_dinero_cumple"
            android:textColor="@color/gamora_on_hero_secondary"
            android:textSize="16sp" />

        <!-- Beneficios -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:lineSpacingExtra="10dp"
            android:text="@string/mainactivity_analiza_a_donde_va"
            android:textColor="@color/gamora_on_hero"
            android:textSize="15sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIniciar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/login_screen_iniciar_sesion"
        android:textColor="@color/gamora_hero_start"
        app:backgroundTint="@color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCrearCuenta"
        style="@style/Widget.Gamora.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/mainactivity_crear_cuenta"
        android:textColor="@color/white"
        app:strokeColor="@color/gamora_on_hero_secondary" />

    <TextView
        android:id="@+id/txtPoliticas"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/mainactivity_politica_de_privacidad"
        android:textColor="@color/gamora_on_hero_secondary"
        android:textSize="14sp" />

</LinearLayout>
