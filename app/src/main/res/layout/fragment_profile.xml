<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gamora_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cuenta"
            android:textAppearance="@style/TextAppearance.Gamora.Overline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mi perfil"
            android:textAppearance="@style/TextAppearance.Gamora.Headline" />

        <!-- Usuario y resumen -->
        <LinearLayout
            style="@style/Gamora.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/gamora_hero_chip"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="G"
                    android:textColor="@color/gamora_on_hero"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombrePerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Mi cuenta"
                        android:textColor="@color/gamora_on_hero"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCorreoPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textColor="@color/gamora_on_hero_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Balance de movimientos"
                android:textColor="@color/gamora_on_hero_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPatrimonio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="$0.00"
                android:textAppearance="@style/TextAppearance.Gamora.Amount"
                android:textSize="32sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_expense"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ahorro acumulado"
                        android:textColor="@color/gamora_on_hero_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvAhorroAcumulado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:text="$0.00"
                        android:textAppearance="@style/TextAppearance.Gamora.AmountSmall"
                        android:textColor="@color/gamora_on_hero"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_expense"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Metas activas"
                        android:textColor="@color/gamora_on_hero_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMetasActivas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.Gamora.AmountSmall"
                        android:textColor="@color/gamora_on_hero"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Mi cuenta -->
        <TextView
            style="@style/Gamora.SectionLabel"
            android:text="Mi cuenta" />

        <LinearLayout
            style="@style/Gamora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/btnInformacionPersonal"
                style="@style/Gamora.SettingRow"
                android:text="👤     Información personal" />

            <View style="@style/Gamora.Divider" />

            <TextView
                android:id="@+id/btnPreferenciasFinancieras"
                style="@style/Gamora.SettingRow"
                android:text="💰     Preferencias financieras" />

            <View style="@style/Gamora.Divider" />

            <TextView
                android:id="@+id/btnRecurrentes"
                style="@style/Gamora.SettingRow"
                android:text="🔁     Movimientos recurrentes" />
        </LinearLayout>

        <!-- Personalización -->
        <TextView
            style="@style/Gamora.SectionLabel"
            android:text="Personalización" />

        <LinearLayout
            style="@style/Gamora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨     Apariencia"
                    android:textColor="@color/gamora_text_primary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/groupTema"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTemaClaro"
                        style="@style/Widget.Gamora.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="44dp"
                        android:text="Claro"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTemaOscuro"
                        style="@style/Widget.Gamora.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="44dp"
                        android:text="Oscuro"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTemaSistema"
                        style="@style/Widget.Gamora.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="44dp"
                        android:text="Sistema"
                        android:textSize="13sp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <View style="@style/Gamora.Divider" />

            <TextView
                android:id="@+id/btnNotificaciones"
                style="@style/Gamora.SettingRow"
                android:text="🔔     Notificaciones" />
        </LinearLayout>

        <!-- Privacidad y ayuda -->
        <TextView
            style="@style/Gamora.SectionLabel"
            android:text="Privacidad y ayuda" />

        <LinearLayout
            style="@style/Gamora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/btnPrivacidad"
                style="@style/Gamora.SettingRow"
                android:text="🔒     Privacidad y seguridad" />

            <View style="@style/Gamora.Divider" />

            <TextView
                android:id="@+id/btnBloqueo"
                style="@style/Gamora.SettingRow"
                android:text="🔐     Bloqueo con huella o PIN" />

            <View style="@style/Gamora.Divider" />

            <TextView
                android:id="@+id/btnPreferenciasIA"
                style="@style/Gamora.SettingRow"
                android:text="✨     Preferencias de inteligencia artificial" />

            <View style="@style/Gamora.Divider" />

            <TextView
                android:id="@+id/btnDocumentosLegales"
                style="@style/Gamora.SettingRow"
                android:text="📄     Documentos legales" />

            <View style="@style/Gamora.Divider" />

            <TextView
                android:id="@+id/btnAyuda"
                style="@style/Gamora.SettingRow"
                android:text="💬     Ayuda y soporte" />
        </LinearLayout>

        <!-- Zona de riesgo -->
        <LinearLayout
            android:id="@+id/btnEliminarDatos"
            style="@style/Gamora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_dashboard_card"
            android:backgroundTint="@color/gamora_expense_container"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Eliminar mis datos"
                android:textColor="@color/gamora_expense"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Borra tu cuenta y toda tu información de forma permanente."
                android:textAppearance="@style/TextAppearance.Gamora.Caption" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            style="@style/Widget.Gamora.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cerrar sesión" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Gamora · Tu dinero, tus decisiones"
            android:textAppearance="@style/TextAppearance.Gamora.Caption" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
