<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".feature.auth.login.LoginScreen"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="40dp">
        <TextView
            android:textStyle="bold"
            android:layout_marginTop="20sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iniciar Sesion"
            android:textSize="30sp"
            android:textColor="@color/gamora_text_primary"
            />

        <EditText
            android:textColorHint="@color/gamora_text_secondary"
            android:layout_marginTop="40sp"
            android:id="@+id/edtCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ejemplo@gmail.com"
            android:textSize="15sp"
            android:inputType="textEmailAddress"
            />
        <EditText
            android:textColorHint="@color/gamora_text_secondary"
            android:layout_marginTop="40sp"
            android:id="@+id/edtPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:hint="Contraseña"
            android:inputType="textPassword"
            />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="80dp"
        android:gravity="center"
        >

        <Button
            android:id="@+id/btnIniciar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp"
            android:text="Iniciar Sesion"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/txtRegistrarse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp"
            android:clickable="true"
            android:text="No tienes una cuenta? Registrate aqui"
            android:textColor="@color/gamora_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>