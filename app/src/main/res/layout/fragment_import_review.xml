<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gamora_background"
    android:orientation="vertical">

    <!-- Cabecera, igual que en el asistente -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gamora_surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnVolverRevision"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chatbot_regresar"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/gamora_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_review_revisa_tus_movimientos"
                android:textAppearance="@style/TextAppearance.Gamora.Title" />

            <TextView
                android:id="@+id/txtOrigenRevision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Gamora.Caption" />
        </LinearLayout>
    </LinearLayout>

    <!-- Encabezado de la tabla (fijo) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@color/gamora_surface_variant"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="10dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbTodos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:contentDescription="@string/import_review_seleccionar_todos"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <TextView
            style="@style/Gamora.TablaEncabezado"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/import_review_fecha" />

        <TextView
            style="@style/Gamora.TablaEncabezado"
            android:layout_width="0dp"
            android:layout_weight="2.4"
            android:text="@string/import_review_descripcion" />

        <TextView
            style="@style/Gamora.TablaEncabezado"
            android:layout_width="0dp"
            android:layout_weight="1.4"
            android:text="@string/import_review_categoria" />

        <TextView
            style="@style/Gamora.TablaEncabezado"
            android:layout_width="0dp"
            android:layout_weight="1.6"
            android:gravity="end"
            android:text="@string/import_review_monto" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/tablaMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Pie fijo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gamora_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/txtResumenRevision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Gamora.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarRevision"
                style="@style/Widget.Gamora.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:text="@string/import_review_cancelar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarRevision"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.6"
                android:text="@string/import_review_guardar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
