<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gamora_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/btnBackChat"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/gamora_text_primary"
            android:textSize="38sp"
            android:contentDescription="Regresar"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gamora AI"
                android:textColor="@color/gamora_text_primary"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tu asistente personal de finanzas"
                android:textColor="@color/gamora_text_secondary"
                android:textSize="12sp"/>

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gamora_border"/>

    <!-- Conversación -->
    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/layoutChatMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="300dp"
                android:background="@drawable/bg_chat_message"
                android:padding="16dp"
                android:text="¡Hola! Soy Gamora AI. Puedo ayudarte a organizar tus finanzas, analizar tus gastos y planificar tus metas de ahorro."
                android:textColor="@color/gamora_text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- Área para escribir -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp">

        <EditText
            android:id="@+id/txtChatMessage"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_user_message"
            android:hint="Escribe un mensaje..."
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/gamora_text_primary"
            android:textColorHint="@color/gamora_text_secondary"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="textCapSentences"
            android:imeOptions="actionSend"/>

        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/gamora_accent"
            android:text="Enviar"
            android:textAllCaps="false"
            android:textColor="@color/gamora_surface"/>

    </LinearLayout>

</LinearLayout>
